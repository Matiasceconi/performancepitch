{
  "name": "FootballStanding",
  "type": "object",
  "properties": {
    "competitionName": {
      "type": "string",
      "description": "Nombre de la competencia: 'Liga Profesional Argentina' o 'Reserve League'"
    },
    "tournament": {
      "type": "string",
      "description": "Torneo: 'Tabla General 2026', 'Apertura', 'Clausura'"
    },
    "group": {
      "type": "string",
      "description": "Zona: 'Zona A' o 'Zona B'"
    },
    "position": {
      "type": "number",
      "description": "Posici\u00f3n en la tabla"
    },
    "teamName": {
      "type": "string",
      "description": "Nombre del equipo"
    },
    "teamLogo": {
      "type": "string",
      "description": "URL del escudo del equipo (puede ser null)"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Puntos totales"
    },
    "played": {
      "type": "number",
      "default": 0,
      "description": "Partidos jugados"
    },
    "won": {
      "type": "number",
      "default": 0,
      "description": "Partidos ganados"
    },
    "drawn": {
      "type": "number",
      "default": 0,
      "description": "Partidos empatados"
    },
    "lost": {
      "type": "number",
      "default": 0,
      "description": "Partidos perdidos"
    },
    "goalsFor": {
      "type": "number",
      "default": 0,
      "description": "Goles a favor"
    },
    "goalsAgainst": {
      "type": "number",
      "default": 0,
      "description": "Goles en contra"
    },
    "goalDifference": {
      "type": "number",
      "default": 0,
      "description": "Diferencia de gol"
    },
    "form": {
      "type": "string",
      "description": "\u00daltimos 5 resultados como string de letras W/D/L (ej: 'WWDLW')"
    },
    "source": {
      "type": "string",
      "description": "Origen de los datos"
    },
    "updatedAt": {
      "type": "string",
      "description": "Fecha/hora de \u00faltima actualizaci\u00f3n"
    }
  },
  "required": [
    "competitionName",
    "tournament",
    "teamName",
    "position"
  ]
}