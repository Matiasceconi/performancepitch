{
  "name": "StrengthBlockTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la plantilla de cuadro"
    },
    "color": {
      "type": "string",
      "default": "#22c55e",
      "description": "Color del cuadro"
    },
    "objective": {
      "type": "string",
      "description": "Objetivo del cuadro"
    },
    "squad_id": {
      "type": "string",
      "description": "Plantel propietario (vac\u00edo si global=true)"
    },
    "squad_name": {
      "type": "string",
      "description": "Nombre del plantel (desnormalizado)"
    },
    "global": {
      "type": "boolean",
      "default": true,
      "description": "Si true, visible desde cualquier plantel"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Snapshot de ejercicios del cuadro. Cada elemento: { library_exercise_id, exercise_name, order, series, rest_time, notes, image_url, video_url }"
    },
    "created_by": {
      "type": "string",
      "description": "ID del usuario creador"
    },
    "created_at": {
      "type": "string",
      "description": "Fecha/hora de creaci\u00f3n"
    }
  },
  "required": [
    "name"
  ]
}