{
  "name": "ComplementaryStrengthBlock",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de organizaci\u00f3n"
    },
    "workout_id": {
      "type": "string",
      "description": "ID del entrenamiento al que pertenece el bloque"
    },
    "block_type": {
      "type": "string",
      "enum": [
        "activation",
        "main",
        "accessories"
      ],
      "default": "main",
      "description": "Tipo de bloque: activaci\u00f3n, principal o accesorios"
    },
    "name": {
      "type": "string",
      "description": "Nombre del bloque"
    },
    "instructions": {
      "type": "string",
      "description": "Indicaciones del bloque"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden del bloque dentro del entrenamiento"
    }
  },
  "required": [
    "workout_id",
    "block_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}