{
  "name": "RecruitmentMeeting",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "squad_id": {
      "type": "string"
    },
    "squad_name": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "meeting_date": {
      "type": "string",
      "format": "date"
    },
    "meeting_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "closed",
        "archived"
      ],
      "default": "draft"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "recruitment_need_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "prospect_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "agenda": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "title",
    "meeting_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}