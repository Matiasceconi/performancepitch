{
  "name": "ValdSyncLog",
  "type": "object",
  "properties": {
    "sync_id": {
      "type": "string",
      "description": "ID \u00fanico de la sincronizaci\u00f3n"
    },
    "product": {
      "type": "string",
      "description": "Producto VALD sincronizado"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "completed",
        "failed",
        "partial"
      ],
      "default": "started",
      "description": "Estado de la sincronizaci\u00f3n"
    },
    "tests_fetched": {
      "type": "number",
      "default": 0,
      "description": "Tests obtenidos de la API"
    },
    "tests_imported": {
      "type": "number",
      "default": 0,
      "description": "Tests nuevos importados"
    },
    "tests_updated": {
      "type": "number",
      "default": 0,
      "description": "Tests actualizados"
    },
    "error_message": {
      "type": "string",
      "description": "Mensaje de error si fall\u00f3"
    },
    "started_at": {
      "type": "string",
      "description": "Fecha/hora de inicio"
    },
    "completed_at": {
      "type": "string",
      "description": "Fecha/hora de finalizaci\u00f3n"
    },
    "triggered_by": {
      "type": "string",
      "description": "Usuario o sistema que dispar\u00f3 la sincronizaci\u00f3n"
    }
  },
  "required": [
    "sync_id",
    "product"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}