{
  "name": "ComplementaryStrengthPlanAssignment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de organizaci\u00f3n"
    },
    "plan_id": {
      "type": "string",
      "description": "ID del plan al que pertenece la asignaci\u00f3n"
    },
    "player_id": {
      "type": "string",
      "description": "ID del jugador asignado"
    },
    "player_name": {
      "type": "string",
      "description": "Nombre del jugador (desnormalizado)"
    },
    "squad_id": {
      "type": "string",
      "description": "Plantel del jugador al momento de la asignaci\u00f3n"
    },
    "assigned_by": {
      "type": "string",
      "description": "ID del usuario que asign\u00f3"
    },
    "assigned_at": {
      "type": "string",
      "description": "Fecha/hora de asignaci\u00f3n"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "removed"
      ],
      "default": "active",
      "description": "Estado de la asignaci\u00f3n. Una sola activa por jugador y plan"
    }
  },
  "required": [
    "plan_id",
    "player_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}