{
  "name": "ScoutingRoleProfile",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Nombre del rol, ej. Central constructor"
    },
    "position_group": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tactical_model": {
      "type": "string"
    },
    "technical_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Criterios {key,label,weight,description}"
    },
    "tactical_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "physical_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "mental_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "market_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "age_min": {
      "type": "number"
    },
    "age_max": {
      "type": "number"
    },
    "preferred_foot": {
      "type": "string",
      "enum": [
        "any",
        "right",
        "left",
        "both"
      ],
      "default": "any"
    },
    "min_height_cm": {
      "type": "number"
    },
    "max_market_value": {
      "type": "number"
    },
    "market_currency": {
      "type": "string",
      "default": "USD"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_by_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}