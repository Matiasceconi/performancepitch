{
  "name": "ScoutingAssignment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "prospect_id": {
      "type": "string"
    },
    "recruitment_need_id": {
      "type": "string"
    },
    "assigned_to_user_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by_user_id": {
      "type": "string"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "assignment_type": {
      "type": "string",
      "enum": [
        "video",
        "live_match",
        "data_review",
        "background_check",
        "follow_up"
      ],
      "default": "video"
    },
    "match_date": {
      "type": "string",
      "format": "date"
    },
    "match_label": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "report_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "prospect_id",
    "assigned_to_user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}