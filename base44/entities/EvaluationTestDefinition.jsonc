{
  "name": "EvaluationTestDefinition",
  "type": "object",
  "properties": {
    "test_key": {
      "type": "string",
      "description": "Clave \u00fanica del test (ej: cmj, sj, cmrj, nordic)"
    },
    "source_key": {
      "type": "string",
      "description": "Clave de la fuente a la que pertenece (ej: forcedecks)"
    },
    "name": {
      "type": "string",
      "description": "Nombre visible del test"
    },
    "short_name": {
      "type": "string",
      "description": "Nombre corto (ej: CMJ)"
    },
    "side_mode": {
      "type": "string",
      "enum": [
        "bilateral",
        "unilateral",
        "na"
      ],
      "default": "bilateral",
      "description": "Modo de lado del test"
    },
    "supports_attempts": {
      "type": "boolean",
      "default": true,
      "description": "Si el test admite m\u00faltiples intentos"
    },
    "priority_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "M\u00e9tricas prioritarias del test (metric_keys)"
    },
    "primary_metric_key": {
      "type": "string",
      "description": "M\u00e9trica principal que define el mejor intento"
    },
    "primary_direction": {
      "type": "string",
      "enum": [
        "higher",
        "lower"
      ],
      "default": "higher",
      "description": "Direcci\u00f3n de la m\u00e9trica principal"
    },
    "secondary_metric_key": {
      "type": "string",
      "description": "Segunda m\u00e9trica para desempatar"
    },
    "secondary_direction": {
      "type": "string",
      "enum": [
        "higher",
        "lower"
      ],
      "default": "higher",
      "description": "Direcci\u00f3n de la m\u00e9trica secundaria"
    },
    "config_version": {
      "type": "number",
      "default": 1,
      "description": "Versi\u00f3n auditable de la regla del mejor intento"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "asymmetry_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "M\u00e9tricas de asimetr\u00eda del test"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si el test est\u00e1 activo"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    },
    "performance_domain": {
      "type": "string",
      "enum": [
        "jump_power",
        "speed_acceleration",
        "change_of_direction",
        "max_strength",
        "eccentric_strength",
        "adductor_groin",
        "intermittent_fitness",
        "repeated_sprint",
        "mobility",
        "anthropometry",
        "other"
      ],
      "default": "other",
      "description": "Dominio f\u00edsico principal del test; independiente del proveedor"
    },
    "purpose_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Usos previstos de la prueba"
    },
    "protocol_summary": {
      "type": "string",
      "description": "Protocolo operativo que debe repetirse para comparar resultados"
    },
    "equipment": {
      "type": "string",
      "description": "Equipamiento requerido o recomendado"
    },
    "surface": {
      "type": "string",
      "description": "Superficie o entorno recomendado"
    },
    "default_attempts": {
      "type": "number",
      "default": 3,
      "description": "Cantidad de intentos sugerida"
    },
    "rest_seconds": {
      "type": "number",
      "description": "Recuperaci\u00f3n sugerida entre intentos"
    },
    "aggregation_method": {
      "type": "string",
      "enum": [
        "best",
        "mean",
        "median",
        "best_two_mean",
        "last"
      ],
      "default": "best",
      "description": "Forma de resumir intentos para seguimiento longitudinal"
    },
    "familiarization_sessions": {
      "type": "number",
      "default": 0,
      "description": "Sesiones de familiarizaci\u00f3n recomendadas"
    },
    "maturity_sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Contextualizar por maduraci\u00f3n biol\u00f3gica en juveniles"
    },
    "reliability_icc": {
      "type": "number",
      "description": "ICC documentado para el protocolo"
    },
    "reliability_cv": {
      "type": "number",
      "description": "CV porcentual documentado para el protocolo"
    },
    "evidence_note": {
      "type": "string",
      "description": "Nota t\u00e9cnica sobre evidencia y limitaciones"
    },
    "reference_url": {
      "type": "string",
      "description": "Referencia t\u00e9cnica opcional"
    }
  },
  "required": [
    "test_key",
    "source_key",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}