{
  "name": "ScoutingWatchlist",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "watchlist_type": {
      "type": "string",
      "enum": [
        "longlist",
        "shortlist",
        "shadow_squad",
        "monitoring",
        "custom"
      ],
      "default": "custom"
    },
    "recruitment_need_id": {
      "type": "string"
    },
    "squad_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "department",
        "club"
      ],
      "default": "department"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}