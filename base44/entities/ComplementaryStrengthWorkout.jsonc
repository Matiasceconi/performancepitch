{
  "name": "ComplementaryStrengthWorkout",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de organizaci\u00f3n"
    },
    "plan_id": {
      "type": "string",
      "description": "ID del plan padre"
    },
    "workout_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha local estable del entrenamiento (YYYY-MM-DD en America/Argentina/Buenos_Aires)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo del entrenamiento"
    },
    "objective": {
      "type": "string",
      "description": "Objetivo del entrenamiento"
    },
    "estimated_duration_minutes": {
      "type": "number",
      "description": "Duraci\u00f3n estimada en minutos"
    },
    "instructions": {
      "type": "string",
      "description": "Indicaciones del entrenamiento"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "Estado del entrenamiento"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Versi\u00f3n del entrenamiento para snapshots"
    },
    "published_at": {
      "type": "string",
      "description": "Fecha/hora de publicaci\u00f3n"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden visual"
    }
  },
  "required": [
    "plan_id",
    "workout_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}