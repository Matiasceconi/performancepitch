{
  "name": "EvaluationMetricDefinition",
  "type": "object",
  "properties": {
    "metric_key": {
      "type": "string",
      "description": "Clave interna de la m\u00e9trica (ej: jump_height, rsi_mod, peak_force)"
    },
    "metric_label": {
      "type": "string",
      "description": "Etiqueta legible (ej: Altura de salto)"
    },
    "metric_label_en": {
      "type": "string",
      "description": "Etiqueta en ingl\u00e9s (original)"
    },
    "csv_column": {
      "type": "string",
      "description": "Nombre exacto de la columna en el CSV"
    },
    "source_key": {
      "type": "string",
      "description": "Fuente a la que pertenece (ej: forcedecks)"
    },
    "test_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tests donde aparece la m\u00e9trica (ej: cmj, sj)"
    },
    "unit": {
      "type": "string",
      "description": "Unidad (cm, N, W, ms, %, kg, m/s)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "range",
        "contextual",
        "none"
      ],
      "default": "higher_is_better",
      "description": "Direcci\u00f3n de interpretaci\u00f3n"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "number",
        "integer",
        "percentage",
        "duration_ms"
      ],
      "default": "number",
      "description": "Tipo de valor"
    },
    "precision": {
      "type": "number",
      "description": "Cantidad de decimales usada s\u00f3lo para la huella de duplicados"
    },
    "catalog_version": {
      "type": "number",
      "default": 1,
      "description": "Versi\u00f3n del cat\u00e1logo fuente + prueba + m\u00e9trica"
    },
    "allows_negative": {
      "type": "boolean",
      "default": false,
      "description": "Si puede tener valores negativos"
    },
    "is_asymmetry": {
      "type": "boolean",
      "default": false,
      "description": "Si es una m\u00e9trica de asimetr\u00eda"
    },
    "category": {
      "type": "string",
      "enum": [
        "performance",
        "force",
        "power",
        "velocity",
        "asymmetry",
        "reactive",
        "other"
      ],
      "default": "performance",
      "description": "Categor\u00eda de la m\u00e9trica"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n t\u00e9cnica"
    },
    "normalization_notes": {
      "type": "string",
      "description": "Notas de normalizaci\u00f3n de la clave"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si est\u00e1 activa para visualizaci\u00f3n"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "metric_key",
    "metric_label",
    "source_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}